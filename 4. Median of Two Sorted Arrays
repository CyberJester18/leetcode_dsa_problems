class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        int n= nums1.length , m=nums2.length;
        int[] merged = new int [n+m];
        int i=0 ,j=0,k=0;

        //merged two arrays
        while(i<n && j<m) {
            if(nums1[i] <= nums2[j]){
                merged[k++] = nums1[i++];}
                else{
                    merged[k++] = nums2[j++];}
                }
            
            while(i<n){ 
                merged[k++] = nums1[i++];}
            while(j<m) {
                merged[k++] = nums2[j++];}
                int len=n+m;
            if (len == 0) {
            return 0.0; // or throw an exception depending on problem statement
        }
            
            if (len %2==1){
                return merged[len/2];}
                else{

                    return(merged[len/2-1]+merged[len/2])/2.0;
                }
        
            }
        }
